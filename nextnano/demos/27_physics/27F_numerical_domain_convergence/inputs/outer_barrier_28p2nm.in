# Demo 27F: outer_barrier_28p2nm
# Question: Does a thicker outer barrier change the high states or the continuum onset?
# Controlled change vs the Demo 23 baseline: One numerical knob per deck, against the shared Demo 23 baseline. The sub-demo owns several knobs because the question is about the numerical domain as a whole, but no single deck turns more than one of them - except the state-count deck, where raising the number of states written requires raising the number solved.
# Generated file. Do not hand-edit: edit the sub-demo config.yaml or
# framework/decks.py, then re-run --preflight.

global{
    simulate1D{}
    temperature = 300
    substrate{ name = "GaAs" }
    crystal_zb{ x_hkl = [1, 0, 0]  y_hkl = [0, 1, 0] }
}

# No doping: the structure carries no fixed charge.

contacts{ fermi{ name = qw_contact  bias = 0.0 } }

grid{
    xgrid{
        line{ pos = 0 spacing = 0.5 }
        line{ pos = 14.1 spacing = 0.05 }
        line{ pos = 21.2 spacing = 0.05 }
        line{ pos = 23 spacing = 0.05 }
        line{ pos = 25.9 spacing = 0.05 }
        line{ pos = 40 spacing = 0.5 }
    }
}

structure{
    output_region_index{ boxes = no }
    output_material_index{ boxes = no }
    output_alloy_composition{ boxes = no }
    region{ everywhere{} ternary_constant{ name = "Al(x)Ga(1-x)As" alloy_x = 0.55 } }
    region{ line{ x = [0, 40] } contact{ name = qw_contact } }
    region{ line{ x = [14.1, 21.2] } binary{ name = "GaAs" } }
    region{ line{ x = [23, 25.9] } binary{ name = "GaAs" } }
    region{ line{ x = [13.6, 14.6] } ternary_linear{ name = "Al(x)Ga(1-x)As" alloy_x = [0.55, 0] x = [13.6, 14.6] } }
    region{ line{ x = [20.7, 21.7] } ternary_linear{ name = "Al(x)Ga(1-x)As" alloy_x = [0, 0.55] x = [20.7, 21.7] } }
    region{ line{ x = [22.5, 23.5] } ternary_linear{ name = "Al(x)Ga(1-x)As" alloy_x = [0.55, 0] x = [22.5, 23.5] } }
    region{ line{ x = [25.4, 26.4] } ternary_linear{ name = "Al(x)Ga(1-x)As" alloy_x = [0, 0.55] x = [25.4, 26.4] } }
}

classical{
    Gamma{}
    HH{}
    LH{}
    SO{}
    output_bandedges{ averaged = no }
    output_bandgap{}
}

# Flat band: no poisson{} block, so no electrostatic feedback exists.

quantum{
    region{
        name = "acqw"
        x = [12.1, 27.9]
        no_density = yes
        boundary{ x = dirichlet }
        kp_8band{
            num_electrons = 6
            num_holes     = 8
            k_integration_disabled{}
            dispersion{
                path{
                    name = "Gamma_to_y"
                    point{ k = [0, 0, 0] }
                    point{ k = [0, 0.555714439232, 0] }
                    num_points = 301
                }
                output_k_vectors{}
                output_dispersions{ max_num = 14 }
                output_masses{ max_num = 14 }
            }
            classify_by_energy{}
        }
        output_states{
            max_num = 14
            all_k_points = yes
            envelopes = yes
            envelopes_CB_HH_LH_SO = yes
            probabilities = yes
            probabilities_partial_CB_HH_LH_SO = yes
            spinor_composition = yes
            spinor_composition_CB_HH_LH_SO = yes
            in_one_file = no
        }
        transition_energies{ all_k_points = yes  KP8{} }
        dipole_moment_matrix_elements{
            polarization{ name = "growth_z" re = [1, 0, 0] }
            all_k_points = yes
            KP8{}
        }
        momentum_matrix_elements{
            polarization{ name = "growth_z" re = [1, 0, 0] }
            polarization{ name = "inplane_y" re = [0, 1, 0] }
            all_k_points = yes
            KP8{}
            output_matrix_elements = yes
            output_oscillator_strengths = yes
        }
    }
}

run{
    quantum{}
}
