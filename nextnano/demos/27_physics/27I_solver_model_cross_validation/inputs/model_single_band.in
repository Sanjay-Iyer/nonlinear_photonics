# Demo 27I: model_single_band
# Question: Which features survive a decoupled parabolic Gamma/HH treatment?
# Controlled change vs the Demo 23 baseline: The quantum model. The single-band deck also drops the k path, because a decoupled Gamma/HH model has no in-plane k dependence to sample in this deck form - that is the second field, and it is a consequence of the first rather than an independent choice.
# Generated file. Do not hand-edit: edit the sub-demo config.yaml or
# framework/decks.py, then re-run --preflight.

global{
    simulate1D{}
    temperature = 300
    substrate{ name = "GaAs" }
    crystal_zb{ x_hkl = [1, 0, 0]  y_hkl = [0, 1, 0] }
}

# No doping: the structure carries no fixed charge.

contacts{ fermi{ name = qw_contact  bias = 0.0 } }

grid{
    xgrid{
        line{ pos = 0 spacing = 0.5 }
        line{ pos = 9.1 spacing = 0.05 }
        line{ pos = 16.2 spacing = 0.05 }
        line{ pos = 18 spacing = 0.05 }
        line{ pos = 20.9 spacing = 0.05 }
        line{ pos = 30 spacing = 0.5 }
    }
}

structure{
    output_region_index{ boxes = no }
    output_material_index{ boxes = no }
    output_alloy_composition{ boxes = no }
    region{ everywhere{} ternary_constant{ name = "Al(x)Ga(1-x)As" alloy_x = 0.55 } }
    region{ line{ x = [0, 30] } contact{ name = qw_contact } }
    region{ line{ x = [9.1, 16.2] } binary{ name = "GaAs" } }
    region{ line{ x = [18, 20.9] } binary{ name = "GaAs" } }
    region{ line{ x = [8.6, 9.6] } ternary_linear{ name = "Al(x)Ga(1-x)As" alloy_x = [0.55, 0] x = [8.6, 9.6] } }
    region{ line{ x = [15.7, 16.7] } ternary_linear{ name = "Al(x)Ga(1-x)As" alloy_x = [0, 0.55] x = [15.7, 16.7] } }
    region{ line{ x = [17.5, 18.5] } ternary_linear{ name = "Al(x)Ga(1-x)As" alloy_x = [0.55, 0] x = [17.5, 18.5] } }
    region{ line{ x = [20.4, 21.4] } ternary_linear{ name = "Al(x)Ga(1-x)As" alloy_x = [0, 0.55] x = [20.4, 21.4] } }
}

classical{
    Gamma{}
    HH{}
    LH{}
    SO{}
    output_bandedges{ averaged = no }
    output_bandgap{}
}

# Flat band: no poisson{} block, so no electrostatic feedback exists.

quantum{
    region{
        name = "acqw"
        x = [7.1, 22.9]
        no_density = yes
        boundary{ x = dirichlet }
        Gamma{ num_ev = 6 }
        HH{    num_ev = 8 }
        output_states{
            max_num = 14
            envelopes = yes
            probabilities = yes
            in_one_file = no
        }
        transition_energies{ Gamma_HH{} }
        dipole_moment_matrix_elements{
            polarization{ name = "growth_z" re = [1, 0, 0] }
            Gamma{}
            HH{}
        }
        momentum_matrix_elements{
            polarization{ name = "growth_z" re = [1, 0, 0] }
            polarization{ name = "inplane_y" re = [0, 1, 0] }
            Gamma{}
            HH{}
            output_matrix_elements = yes
            output_oscillator_strengths = yes
        }
    }
}

run{
    quantum{}
}
