# Demo 27K: continuum_pad2_outer34
# Question: Which of them move when the outer barrier gets thicker?
# Controlled change vs the Demo 23 baseline: Many more states than the structure binds, solved on three different numerical domains. The state count is the sub-demo's subject; the domain is varied because that is the only way to tell a real quasi-bound resonance from a Dirichlet box level, and holding it fixed would make the question unanswerable rather than controlled.
# Generated file. Do not hand-edit: edit the sub-demo config.yaml or
# framework/decks.py, then re-run --preflight.

global{
    simulate1D{}
    temperature = 300
    substrate{ name = "GaAs" }
    crystal_zb{ x_hkl = [1, 0, 0]  y_hkl = [0, 1, 0] }
}

# No doping: the structure carries no fixed charge.

contacts{ fermi{ name = qw_contact  bias = 0.0 } }

grid{
    xgrid{
        line{ pos = 0 spacing = 0.5 }
        line{ pos = 17.1 spacing = 0.05 }
        line{ pos = 24.2 spacing = 0.05 }
        line{ pos = 26 spacing = 0.05 }
        line{ pos = 28.9 spacing = 0.05 }
        line{ pos = 46 spacing = 0.5 }
    }
}

structure{
    output_region_index{ boxes = no }
    output_material_index{ boxes = no }
    output_alloy_composition{ boxes = no }
    region{ everywhere{} ternary_constant{ name = "Al(x)Ga(1-x)As" alloy_x = 0.55 } }
    region{ line{ x = [0, 46] } contact{ name = qw_contact } }
    region{ line{ x = [17.1, 24.2] } binary{ name = "GaAs" } }
    region{ line{ x = [26, 28.9] } binary{ name = "GaAs" } }
    region{ line{ x = [16.6, 17.6] } ternary_linear{ name = "Al(x)Ga(1-x)As" alloy_x = [0.55, 0] x = [16.6, 17.6] } }
    region{ line{ x = [23.7, 24.7] } ternary_linear{ name = "Al(x)Ga(1-x)As" alloy_x = [0, 0.55] x = [23.7, 24.7] } }
    region{ line{ x = [25.5, 26.5] } ternary_linear{ name = "Al(x)Ga(1-x)As" alloy_x = [0.55, 0] x = [25.5, 26.5] } }
    region{ line{ x = [28.4, 29.4] } ternary_linear{ name = "Al(x)Ga(1-x)As" alloy_x = [0, 0.55] x = [28.4, 29.4] } }
}

classical{
    Gamma{}
    HH{}
    LH{}
    SO{}
    output_bandedges{ averaged = no }
    output_bandgap{}
}

# Flat band: no poisson{} block, so no electrostatic feedback exists.

quantum{
    region{
        name = "acqw"
        x = [15.1, 30.9]
        no_density = yes
        boundary{ x = dirichlet }
        kp_8band{
            num_electrons = 28
            num_holes     = 36
            k_integration_disabled{}
            dispersion{
                path{
                    name = "Gamma_to_y"
                    point{ k = [0, 0, 0] }
                    point{ k = [0, 0.555714439232, 0] }
                    num_points = 301
                }
                output_k_vectors{}
                output_dispersions{ max_num = 64 }
                output_masses{ max_num = 64 }
            }
            classify_by_energy{}
        }
        output_states{
            max_num = 64
            all_k_points = yes
            envelopes = yes
            envelopes_CB_HH_LH_SO = yes
            probabilities = yes
            probabilities_partial_CB_HH_LH_SO = yes
            spinor_composition = yes
            spinor_composition_CB_HH_LH_SO = yes
            in_one_file = no
        }
        transition_energies{ all_k_points = yes  KP8{} }
        dipole_moment_matrix_elements{
            polarization{ name = "growth_z" re = [1, 0, 0] }
            all_k_points = yes
            KP8{}
        }
        momentum_matrix_elements{
            polarization{ name = "growth_z" re = [1, 0, 0] }
            polarization{ name = "inplane_y" re = [0, 1, 0] }
            all_k_points = yes
            KP8{}
            output_matrix_elements = yes
            output_oscillator_strengths = yes
        }
    }
}

run{
    quantum{}
}
