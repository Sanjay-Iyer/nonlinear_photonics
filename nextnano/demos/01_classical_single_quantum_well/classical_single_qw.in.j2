# Demo 1: classical GaAs/AlGaAs single quantum well.
# Syntax basis: validated hello_02_algaas_qw.in global, contacts, structure,
# and classical blocks.
# LICENSED VALIDATION: nextnano++ 3.0.0 (2026-06-16 kernel) accepted and
# executed this classical-only deck on 2026-07-30, writing Gamma/HH/LH/SO
# band edges and finishing with DONE.

global{
    simulate1D{}
    crystal_zb{ x_hkl = [1, 0, 0]  y_hkl = [0, 1, 0] }
    substrate{ name = "GaAs" }
    temperature = {{temperature_K}}
}

contacts{
    # Required top-level nextnano++ object. This neutral contact supplies no
    # bias and does not enable Poisson, transport, or quantum calculations.
    fermi{ name = qw_contact  bias = 0.0 }
}

grid{
    xgrid{
        line{ pos = 0.0                  spacing = {{exterior_grid_spacing_nm}} }
        line{ pos = {{well_start_nm}}    spacing = {{active_region_grid_spacing_nm}} }
        line{ pos = {{well_end_nm}}      spacing = {{active_region_grid_spacing_nm}} }
        line{ pos = {{domain_end_nm}}    spacing = {{exterior_grid_spacing_nm}} }
    }
}

structure{
    region{
        everywhere{}
        ternary_constant{
            name = "Al(x)Ga(1-x)As"
            alloy_x = {{aluminum_fraction}}
        }
        contact{ name = qw_contact }
    }
    region{
        line{ x = [{{well_start_nm}}, {{well_end_nm}}] }
        binary{ name = "GaAs" }
    }
}

classical{
    Gamma{}
    HH{}
    LH{}
    SO{}
    output_bandedges{ averaged = no }
}

run{
}
