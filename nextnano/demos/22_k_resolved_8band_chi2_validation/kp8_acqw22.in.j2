# Demo 22: structure-specific k-resolved 8-band k.p validation.
# Primary = ideal-abrupt paper geometry; secondary = 1 nm linear Case 04 control.
# Generated file. Do not hand-edit: edit demo22_config.yaml or deck22.py.

global{
    simulate1D{}
    temperature = {{ temperature_K }}
    substrate{ name = "GaAs" }
    crystal_zb{ x_hkl = [1, 0, 0]  y_hkl = [0, 1, 0] }
}

contacts{ fermi{ name = qw_contact  bias = 0.0 } }

grid{
    xgrid{
{{ grid_lines }}
    }
}

structure{
    output_region_index{ boxes = no }
    output_material_index{ boxes = no }
    output_alloy_composition{ boxes = no }
{{ structure_regions }}
}

classical{
    Gamma{}
    HH{}
    LH{}
    SO{}
    output_bandedges{ averaged = no }
    output_bandgap{}
}

quantum{
    region{
        name = "acqw"
        x = [{{ quantum_start_nm }}, {{ quantum_end_nm }}]
        no_density = yes
        boundary{ x = dirichlet }
        kp_8band{
            num_electrons = {{ num_electrons }}
            num_holes     = {{ num_holes }}
{{ k_block }}
            classify_by_energy{}
        }
        output_states{
            max_num = {{ output_state_count }}
            all_k_points = yes
            envelopes = yes
            envelopes_CB_HH_LH_SO = yes
            probabilities = yes
            probabilities_partial_CB_HH_LH_SO = yes
            spinor_composition = yes
            spinor_composition_CB_HH_LH_SO = yes
            in_one_file = no
        }
        transition_energies{ all_k_points = yes  KP8{} }
        dipole_moment_matrix_elements{
            polarization{ name = "growth_z" re = [1, 0, 0] }
            all_k_points = yes
            KP8{}
        }
        momentum_matrix_elements{
            polarization{ name = "growth_z" re = [1, 0, 0] }
            polarization{ name = "inplane_y" re = [0, 1, 0] }
            all_k_points = yes
            KP8{}
            output_matrix_elements = yes
            output_oscillator_strengths = yes
        }
    }
}

run{ quantum{} }

