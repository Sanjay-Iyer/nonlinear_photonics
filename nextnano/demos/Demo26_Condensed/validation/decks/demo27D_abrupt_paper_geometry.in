# Demo 27D: abrupt_paper_geometry
# Question: Does the ideal abrupt structure move P1/Z1/P2/P3/Z2/P4 towards the paper?
# Controlled change vs the Demo 23 baseline: The interface model, and nothing else. Layer widths, Al fractions, mesh, temperature, state count, k range and k sampling are the Demo 23 baseline, so the only thing that can move a spectral feature is the interface abruptness. The geometry is NOT optimized here; 27D asks whether the paper's structure explains the disagreement, not which structure fits best.
# Generated file. Do not hand-edit: edit the sub-demo config.yaml or
# framework/decks.py, then re-run --preflight.

global{
    simulate1D{}
    temperature = 300
    substrate{ name = "GaAs" }
    crystal_zb{ x_hkl = [1, 0, 0]  y_hkl = [0, 1, 0] }
}

# No doping: the structure carries no fixed charge.

contacts{ fermi{ name = qw_contact  bias = 0.0 } }

grid{
    xgrid{
        line{ pos = 0 spacing = 0.5 }
        line{ pos = 9.1 spacing = 0.05 }
        line{ pos = 16.2 spacing = 0.05 }
        line{ pos = 18 spacing = 0.05 }
        line{ pos = 20.9 spacing = 0.05 }
        line{ pos = 30 spacing = 0.5 }
    }
}

structure{
    output_region_index{ boxes = no }
    output_material_index{ boxes = no }
    output_alloy_composition{ boxes = no }
    region{ everywhere{} ternary_constant{ name = "Al(x)Ga(1-x)As" alloy_x = 0.55 } }
    region{ line{ x = [0, 30] } contact{ name = qw_contact } }
    region{ line{ x = [9.1, 16.2] } binary{ name = "GaAs" } }
    region{ line{ x = [18, 20.9] } binary{ name = "GaAs" } }
}

classical{
    Gamma{}
    HH{}
    LH{}
    SO{}
    output_bandedges{ averaged = no }
    output_bandgap{}
}

# Flat band: no poisson{} block, so no electrostatic feedback exists.

quantum{
    region{
        name = "acqw"
        x = [7.1, 22.9]
        no_density = yes
        boundary{ x = dirichlet }
        kp_8band{
            num_electrons = 6
            num_holes     = 8
            k_integration_disabled{}
            dispersion{
                path{
                    name = "Gamma_to_y"
                    point{ k = [0, 0, 0] }
                    point{ k = [0, 0.555714439232, 0] }
                    num_points = 301
                }
                output_k_vectors{}
                output_dispersions{ max_num = 14 }
                output_masses{ max_num = 14 }
            }
            classify_by_energy{}
        }
        output_states{
            max_num = 14
            all_k_points = yes
            envelopes = yes
            envelopes_CB_HH_LH_SO = yes
            probabilities = yes
            probabilities_partial_CB_HH_LH_SO = yes
            spinor_composition = yes
            spinor_composition_CB_HH_LH_SO = yes
            in_one_file = no
        }
        transition_energies{ all_k_points = yes  KP8{} }
        dipole_moment_matrix_elements{
            polarization{ name = "growth_z" re = [1, 0, 0] }
            all_k_points = yes
            KP8{}
        }
        momentum_matrix_elements{
            polarization{ name = "growth_z" re = [1, 0, 0] }
            polarization{ name = "inplane_y" re = [0, 1, 0] }
            all_k_points = yes
            KP8{}
            output_matrix_elements = yes
            output_oscillator_strengths = yes
        }
    }
}

run{
    quantum{}
}
