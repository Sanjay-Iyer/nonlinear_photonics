# Demo 6: doped asymmetric coupled quantum well, staged towards a
# self-consistent Schroedinger-Poisson solution.
#
# One template serves all five stages. The impurities, poisson, quantum, and run
# blocks are generated in Python from the `models:` list in demo.yaml, so the
# deck for every stage is materialised and archived in full and the difference
# between two stages is a diff of two real inputs.
# (Placeholder names are deliberately not spelled out in this comment: the
# renderer substitutes every double-brace placeholder it finds, comments
# included, and an unknown one is a hard error.)
#
# Stage A  undoped, no Poisson              run{ quantum{} }
# Stage B  donors + classical Poisson       run{ poisson{} }
# Stage C  quantum states on the B potential run{ poisson{} quantum{} }, no_density
# Stage D  self-consistent                  run{ quantum_poisson{} }
# Stage E  Stage D repeated over doping
#
# CONTACT PLACEMENT MATTERS HERE. A contact attached to everywhere{} makes the
# whole domain a Dirichlet region, so once Poisson actually runs the potential
# is pinned everywhere and no band bending can appear. Measured on nextnano++
# 3.0.0 at home. The contact is therefore a thin slab at x = 0.
#
# CONVERGENCE. run{ quantum_poisson{} } exits DONE and writes job_done.txt even
# when it has NOT converged; the only in-file evidence is
# "WARNING: QUANTUM-POISSON failed to converge." in summary.log plus the final
# residuals in iteration_quantum_poisson.dat. Both are checked. Do not raise
# `residual` or lower `iterations` to make a run "pass".

global{
    simulate1D{}
    temperature = {{temperature_K}}
    substrate{ name = "GaAs" }
    crystal_zb{ x_hkl = [1, 0, 0]  y_hkl = [0, 1, 0] }
}
{{impurities_block}}
contacts{
    fermi{ name = qw_contact  bias = {{contact_bias_V}} }
}

grid{
    xgrid{
{{grid_lines}}
    }
}

structure{
    output_region_index{ boxes = no }
    output_material_index{ boxes = no }
    output_impurities{ boxes = no }
{{structure_regions}}
}

classical{
    Gamma{}
    HH{}
    LH{}
    SO{}
    output_bandedges{ averaged = no }
    output_carrier_densities{}
    output_ionized_dopant_densities{}
}
{{poisson_block}}
{{quantum_block}}
{{run_block}}
