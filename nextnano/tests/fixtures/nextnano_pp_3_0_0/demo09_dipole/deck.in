# Demo 9: asymmetric coupled quantum well screened as a three-level system.
#
# Syntax basis: repo Demo 5 (validated coupled-well geometry and the imposed
# electrostatic tilt), plus dipole_moment_matrix_elements, which was executed
# and its output inspected at home on nextnano++ 3.0.0 (Free edition,
# 2026-07-30). That run confirmed the file layout and the unit:
#   |<Gamma_i|eps.d|Gamma_j>|[e*nm]
# i.e. with the polarization vector along growth this column IS |z_ij| in nm.
#
# The same values are recomputed independently from the envelopes and the two
# are compared in every run; a disagreement is a defect, not a detail.
#
# Physics deliberately absent: doping, self-consistent charge, strain, k.p,
# transport. Only conduction subbands are involved, so nothing here is an
# interband quantity.

global{
    simulate1D{}
    temperature = 300
    substrate{ name = "GaAs" }
    crystal_zb{ x_hkl = [1, 0, 0]  y_hkl = [0, 1, 0] }
}

contacts{
    fermi{ name = qw_contact  bias = 0.0 }
}

grid{
    xgrid{
        line{ pos = 0  spacing = 1 }
        line{ pos = 20  spacing = 1 }
        line{ pos = 28  spacing = 1 }
        line{ pos = 31  spacing = 1 }
        line{ pos = 36  spacing = 1 }
        line{ pos = 56  spacing = 1 }
    }
}

structure{
    output_region_index{ boxes = no }
    output_material_index{ boxes = no }
    region{
        everywhere{}
        ternary_constant{
            name    = "Al(x)Ga(1-x)As"
            alloy_x = 0.3
        }
    }
    # Mandatory contact confined to a thin slab at x = 0 so that it
    # supplies the electrostatic reference without pinning the whole domain.
    region{
        line{ x = [0, 2] }
        ternary_constant{
            name    = "Al(x)Ga(1-x)As"
            alloy_x = 0.3
        }
        contact{ name = qw_contact }
    }
    # left_well
    region{
        line{ x = [20, 28] }
        binary{ name = "GaAs" }
    }
    # centre_barrier
    region{
        line{ x = [28, 31] }
        ternary_constant{
            name    = "Al(x)Ga(1-x)As"
            alloy_x = 0.3
        }
    }
    # right_well
    region{
        line{ x = [31, 36] }
        binary{ name = "GaAs" }
    }
    # right_outer_barrier
    region{
        line{ x = [36, 56] }
        ternary_constant{
            name    = "Al(x)Ga(1-x)As"
            alloy_x = 0.3
        }
    }
}

classical{
    Gamma{}
    HH{}
    LH{}
    SO{}
    output_bandedges{ averaged = no }
}

poisson{
    electric_field{
        direction = [1, 0, 0]
        strength  = 2000000   # V/m; 20 kV/cm
    }
    output_potential{}
    output_electric_field{}
}

quantum{
    region{
        name = "cqw"
        x = [10, 46]
        no_density = yes
        boundary{ x = dirichlet }
        Gamma{ num_ev = 4 }
        output_states{
            max_num       = 4
            envelopes     = yes
            probabilities = yes
        }
        # Intersubband position matrix elements along the growth axis.
        dipole_moment_matrix_elements{
            polarization{ name = "growth_x"  re = [1, 0, 0] }
            Gamma{}
        }
        # Growth-polarised oscillator strengths, for the selection-rule check.
        momentum_matrix_elements{
            polarization{ name = "growth_x"  re = [1, 0, 0] }
            Gamma{}
            output_matrix_elements      = yes
            output_oscillator_strengths = yes
        }
    }
}

run{
    quantum{}
}
