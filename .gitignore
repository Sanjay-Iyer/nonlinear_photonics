# Nested upstream aestimo checkout keeps its own history
/git/

# Prior-session scratch outputs at repo root
/output/
/hello_well/
/sample_1qw_barrierdope_ingaas/
/integrated_photonics_study_guide/
/.agents/

# Python / caches
__pycache__/
*.pyc
.ipynb_checkpoints/
mpl-cache/

# Large binary sim artifacts inside checkpoints are versioned deliberately;
# keep them, but drop stray temp files
*.tmp
*.log.lock

# ─── nextnano++ home-to-work workflow ───────────────────────────────────────
# Machine-specific local config: created by hand on each machine, never tracked.
# A `git pull` will never overwrite it.
nextnano/config/paths.local.yaml
nextnano/config/machines/nextnano_machine.local.yaml
# Raw solver output: ignore EVERYTHING under output/ (fields, meshes, logs, data,
# temp files all land here), but keep the empty dir in git via its .gitkeep.
# Scoping solver artifacts to output/ this way avoids broad repo-wide *.dat /
# *.log rules that would hide legitimate scientific files elsewhere -- e.g. the
# curated results under nextnano/results/ stay fully tracked.
nextnano/output/**
!nextnano/output/.gitkeep
# Routine demo runs are reproducible and may be large. Curated results elsewhere
# under nextnano/results remain tracked deliberately.
nextnano/results/demo_runs/**
# Any nextnano license file, anywhere -- licensed asset, must never be committed.
*.lic
# Python / test caches (also covered repo-wide above; repeated so this block is
# self-documenting for anyone reading only the nextnano workflow rules).
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# ─── generated run artifacts inside a demo directory ────────────────────────
# A demo directory holds SOURCE: the orchestrator, the config, the template and
# the frozen case list. Runs write to `results_root` (C:\nn_results on the work
# laptop, nextnano/results/demo_runs elsewhere -- both already ignored above), so
# a solver artifact appearing beside the source means a run was pointed at the
# wrong root. Ignored so it cannot be committed by accident; the demo's own
# .in.j2 template and .yaml config are source and stay tracked.
nextnano/demos/**/raw/
nextnano/demos/**/nextnano_input/
nextnano/demos/**/*.log
nextnano/demos/**/*.dat
# ...except the reference decks Demo 16G ships as fixtures, which ARE source.
!nextnano/demos/**/docs/*.nnp

# ─── curated demo results ───────────────────────────────────────────────────
# `demo_results/` is the split-machine hand-off. The work laptop runs the
# licensed solve and commits the curated summaries and figures; the home laptop
# reads them back through `git pull`. That is how demo_results/demo_16E's 10
# figures, 2 CSVs and physics_summary.json got here, and blanket-ignoring a demo
# would mean its licensed run could never reach the home laptop at all.
#
# So the BULK is ignored and the CURATED SET stays tracked, for every demo.
#
# NAMING: the convention is `demo_<id>` with the underscore -- demo_16E,
# demo_17, demo_17b. The un-underscored `demo17`/`demo18` spellings are matched
# too, because both have been created by hand at least once and a rule that only
# covers one spelling silently stops protecting the moment somebody types the
# other. Demo 17b's loader accepts either spelling for the same reason.
demo_results/demo_1[0-9]*/cases/
demo_results/demo_1[0-9]*/p[0-9][0-9]/
demo_results/demo_1[0-9]*/**/raw/
demo_results/demo_1[0-9]*/**/*.log
demo_results/demo_1[0-9]*/**/*.dat
# ...but the Demo 17/17b hand-off DOES carry envelopes and matrix elements, which
# are the inputs Demo 17b re-evaluates Eq. 2 from. Those are curated inputs, not
# bulk solver output, so they stay tracked wherever they land.
!demo_results/**/envelopes.csv
!demo_results/**/matrix_elements.json
!demo_results/**/paper_target_*/**
